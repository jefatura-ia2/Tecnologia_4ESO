# Variables para la opción Docker (servidor del centro).
# En Netlify, estas mismas variables se ponen en Site configuration → Environment variables
# (allí además puedes usar SKIP_WEEKS=2026-12-21,2026-12-28 para saltar vacaciones).

# Copia este archivo como .env y cambia los valores antes de arrancar.

# Puerto en el que se abrirá la web (http://IP-del-servidor:8080)
PORT=8080

# Clave secreta para las sesiones: pon una cadena larga y aleatoria
SECRET_KEY=cambia-esto-por-una-cadena-larga-y-aleatoria

# Cuenta del profesorado (se crea al primer arranque)
TEACHER_USERNAME=profesor
TEACHER_PASSWORD=cambiame
TEACHER_FULLNAME=Profesor/a de Tecnología

# Código que el alumnado escribe al registrarse
CLASS_CODE=4ESO-NEUMA

# Primer día del trimestre (AAAA-MM-DD)
COURSE_START_DATE=2026-09-14
COURSE_WEEKS=36
HOURS_PER_WEEK=3

# Anti-trampa
MIN_SECONDS_BEFORE_SUBMIT=120
FREE_ATTEMPTS=3
COOLDOWN_BASE_SECONDS=60
PLAGIARISM_THRESHOLD=0.92
